+import { createHash } from "node:crypto";
+import { cp, mkdir, readdir, readFile, writeFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { editingReplacements } from "./studio-app-editing.mjs";
+import { reconciliationReplacements } from "./studio-app-reconciliation.mjs";
+import { selectionReplacements } from "./studio-app-selection.mjs";
+import { storageReplacements } from "./studio-app-storage.mjs";
+import { tableReplacements } from "./studio-app-tables.mjs";
+
+const supportedVersion = "1.8.0";
+const replacements = [
+  ...storageReplacements,
+  ...editingReplacements,
+  ...tableReplacements,
+  ...selectionReplacements,
+  ...reconciliationReplacements,
+];
+
+/**
+ * Apply the reviewed compatibility fixes only when every pinned source boundary still matches.
+ * @param {string} source
+ * @param {string} version
+ * @returns {string}
+ */
+export function patchStudioAppBundle(source, version) {
+  if (version !== supportedVersion) {
+    throw new Error("Nuxt Studio embedded app compatibility patch requires version " + supportedVersion + ".");
+  }
+  for (const { before, occurrences = 1 } of replacements) {
+    if (source.split(before).length !== occurrences + 1) {
+      throw new Error("Nuxt Studio embedded app compatibility patch no longer matches: " + before.slice(0, 80));
+    }
+  }
+  for (const { before, after, occurrences = 1 } of replacements) {
+    source = occurrences === 1 ? source.replace(before, after) : source.replaceAll(before, after);
+  }
+  return source;
+}
+
+/**
+ * Copy the packaged app and expose patched bytes at a new immutable URL on every content change.
+ * Original package assets remain untouched; relative shared chunks, styles, and workers stay together.
+ * @param {{ version: string, appDirectory: string, buildDirectory: string }} options
+ * @returns {Promise<{ directory: string, baseURL: string }>}
+ */
+export async function prepareStudioAppAssets({ version, appDirectory, buildDirectory }) {
+  const source = await readFile(resolve(appDirectory, "main.js"), "utf8");
+  const patchedSource = patchStudioAppBundle(source, version);
+  const fingerprint = createHash("sha256");
+  /** @param {string} relativeDirectory */
+  async function collectFiles(relativeDirectory = "") {
+    const entries = await readdir(resolve(appDirectory, relativeDirectory), { withFileTypes: true });
+    const paths = [];
+    for (const entry of entries) {
+      const relativePath = relativeDirectory ? `${relativeDirectory}/${entry.name}` : entry.name;
+      if (entry.isDirectory()) {
+        paths.push(...await collectFiles(relativePath));
+      } else if (entry.isFile()) {
+        paths.push(relativePath);
+      } else {
