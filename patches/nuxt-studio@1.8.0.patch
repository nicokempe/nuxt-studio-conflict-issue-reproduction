+      const connection = request.result;
+      if (settled) {
+        connection.close();
+        return;
+      }
+      settled = true;
+      if (openTimeout !== undefined) clearTimeout(openTimeout);
+      connection.onversionchange = () => connection.close();
+      resolve(connection);
+    };
+  });
+}
+
+/** Opens the latest schema and repairs a missing store without replacing existing draft data. */
+async function openDB() {
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const connection = await openDBRequest();
+    if (connection.objectStoreNames.contains(STORE_NAME)) return connection;
+    const nextVersion = connection.version + 1;
+    connection.close();
+    try {
+      const upgraded = await openDBRequest(nextVersion);
+      if (upgraded.objectStoreNames.contains(STORE_NAME)) return upgraded;
+      upgraded.close();
+    } catch (error) {
+      // A different tab may have upgraded since the schema was inspected.
+      if (error?.name !== 'VersionError') throw error;
+    }
+  }
+  throw new Error('Studio could not prepare its local media draft storage after concurrent updates. Close other tabs for this site and reload Studio.');
+}
+
+/** Reads one draft and releases its connection on every completion or failure path. */
+function getData(key) {
+  return openDB().then(connection => new Promise((resolve, reject) => {
+    let settled = false;
+    let result;
+
+    function fail(error) {
+      if (settled) return;
+      settled = true;
+      connection.close();
+      reject(error);
+    }
+
+    try {
+      const transaction = connection.transaction(STORE_NAME, 'readonly');
+      const request = transaction.objectStore(STORE_NAME).get(key);
+      request.onsuccess = () => {
+        result = request.result;
+      };
+      request.onerror = () => fail(request.error || new Error('Studio could not read its local media draft.'));
+      transaction.onerror = () => fail(transaction.error || request.error || new Error('Studio media draft storage transaction failed.'));
+      transaction.onabort = () => fail(transaction.error || new Error('Studio media draft storage transaction was aborted.'));
+      transaction.oncomplete = () => {
+        if (settled) return;
+        settled = true;
+        connection.close();
+        resolve(result);
+      };
+    } catch (error) {
+      fail(error);
+    }
+  }));
+}
+`;
+}
