# Local development uses Studio's development mode and needs no credentials.
# For a real production-host session, create a GitHub OAuth App for your host.
# Callback: http://localhost:3000/__nuxt_studio/auth/github
# Use your actual HTTPS host instead when deployed.
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Generate locally: openssl rand -base64 32
NUXT_STUDIO_AUTH_SESSION_SECRET=
# Comma-separated GitHub verified email addresses permitted to sign in.
NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
# Set this to fixes when testing that branch against GitHub.
STUDIO_REPOSITORY_BRANCH=main
